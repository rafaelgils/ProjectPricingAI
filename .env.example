# Copie para .env (fora do Git) e troque os valores antes de subir: cp .env.example .env
# Fora do ambiente local, estes segredos ficam no AWS Secrets Manager (tech-stack.md).

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_APP_DATABASE=precificacao
MONGO_APP_USER=precificacao_app
MONGO_APP_PASSWORD=troque-esta-senha

# Keycloak (administrador inicial do console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha

# Keycloak: segredo do cliente precificacao-admin (Backend → Admin API)
KEYCLOAK_ADMIN_CLIENT_SECRET=troque-este-segredo

# Keycloak: senha dos usuários de teste (admin.teste, interno.teste, externo.teste). Só ambiente local.
KEYCLOAK_TEST_USER_PASSWORD=troque-esta-senha

# Keycloak: chave privada RSA fixa do realm (ADR-010). Não preencha à mão:
# rode ./scripts/gerar-chave-realm.sh, que grava aqui a privada e no kong.yml a pública.
REALM_RSA_PRIVATE_KEY=

# Claude API (usada a partir da fase F6)
ANTHROPIC_API_KEY=
