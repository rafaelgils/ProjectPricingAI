# Copie para .env (fora do Git) e troque os valores antes de subir: cp .env.example .env
# Fora do ambiente local, estes segredos ficam no AWS Secrets Manager (tech-stack.md).

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_APP_DATABASE=precificacao
MONGO_APP_USER=precificacao_app
MONGO_APP_PASSWORD=troque-esta-senha

# Keycloak (administrador inicial do console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha

# Claude API (usada a partir da fase F6)
ANTHROPIC_API_KEY=
