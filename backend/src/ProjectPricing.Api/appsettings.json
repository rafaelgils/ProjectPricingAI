{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "UrlPublica": "http://localhost:8080/realms/precificacao",
    "UrlInterna": "",
    "Audiencia": "precificacao-api",
    "ExigirHttpsMetadata": true,
    "AdminClientId": "precificacao-admin",
    "AdminClientSecret": ""
  },
  "Anthropic": {
    "Modelo": "claude-opus-5-5",
    "Esforco": "Medium",
    "MaxTokens": 16000,
    "TimeoutSegundos": 90
  }
}
